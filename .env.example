# Copy to `.env` and adjust as needed. Every value is a local-only default;
# nothing here is production material. Compose picks this file up automatically.
#
# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=main
POSTGRES_PORT=5432

# Neon serverless proxy
PROXY_PORT=4444

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
